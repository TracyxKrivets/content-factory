# Everything is optional. With no keys the app runs in OFFLINE mode
# (built-in robot voice + generated title-card visuals) so you can test the whole pipeline.

# ---- AI text (scripts). First one found is used; others become backups.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides (cheap = simple tasks, quality = creative writing)
OPENAI_MODEL_CHEAP=gpt-4.1-mini
OPENAI_MODEL_QUALITY=gpt-4.1
ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
ANTHROPIC_MODEL_QUALITY=claude-sonnet-5-5

# ---- Voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# OPENAI_API_KEY above also enables OpenAI voice + images

# ---- Visuals
PEXELS_API_KEY=

# ---- Database + file storage (optional). Without these, data is saved to ./data on disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=content-factory

# ---- Worker
# How many videos render at the same time
WORKER_CONCURRENCY=2
# Set to "false" if you run the worker as a separate process
EMBEDDED_WORKER=true
